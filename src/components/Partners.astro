---
import { supabase } from "../lib/partnere.js";
import Partnere from "../assets/partnere.svg";

const { data: partnere, error } = await supabase
  .from("partnere")
  .select("*")
  .order("id");

if (error) throw error;
---

<div class="section-start">
  <h2 class="section-small-title">SAMMEN GØR VI EN FORSKEL</h2>
  <h1 class="section-title">Vores samarbejdspartnere</h1>
  <p class="section-description">
    Dankort Øremærket skabes i fællesskab med virksomheder og organisationer,
    der ligesom os, ønsker at give mere tilbage til naturen
  </p>
</div>

<section class="partner-grid">
  {
    partnere.map((partner) => (
      <>
        <div class="partner-card-img">
          <a href={`${partner.slug}`} class="partner-card">
            <div class="partner-content">
              <img
                class="partner-logo"
                src={partner.logo_url}
                alt={partner.navn}
              />

              <span class="partner-type">{partner.type}</span>
              <p class="partner-navn">{partner.navn}</p>
              <p class="partner-description">{partner.beskrivelse}</p>
            </div>
          </a>
          <div class="partner-image">
            <img src={partner.billed_url} alt={partner.navn} />
          </div>
        </div>
      </>
    ))
  }
</section>
<div class="flere-kommer">
  <img src={Partnere.src} alt="" class="blue-people" />
  <h2>Flere partnere på vej</h2>
</div>
<style>
  .partner-grid {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    padding: 1rem;
  }

  .partner-card {
    background: var(--white);
    box-shadow:
      -10px -10px 15px var(--light-lightest-grey),
      inset -10px -10px 15px var(--light-lightest-grey);
    border-radius: 25px;
    border: var(--glass-border);
    overflow: hidden;
    text-decoration: none;
    color: var(--black);
    transition: transform 0.2s ease;
    display: flex;
    flex-direction: row;
    height: 250px;
  }

  .partner-card:hover {
    transform: translateY(-5px);
  }

  .partner-content {
    padding: 2rem 1rem;
    display: flex;
    flex-direction: column;
  }

  .partner-logo {
    height: 50px;
    width: 80px;
    object-fit: contain;
    align-self: left;
  }

  .partner-type {
    display: inline-block;
    box-shadow:
      -10px -10px 15px var(--light-lightest-grey),
      inset -10px -10px 15px var(--light-lightest-grey);
    padding: 10px 15px;
    margin-top: 1rem;
    border-radius: 25px;
    /* background: var(--light-grey); */
    border: var(--glass-border);
    font-size: 10px;
    width: fit-content;
    font-weight: var(--semibold);
    color: var(--black);
  }

  .partner-description {
    font-size: var(--p-mobile);
    padding: 1rem 0;
    text-align: left;
    color: var(--black);
    max-width: 200px;
  }
  .partner-card-img {
    display: flex;
    flex-direction: row;
    gap: 0;
  }
  .partner-image img {
    height: 100%;
    width: 100%;
    object-fit: cover;
    object-position: center;
    border-radius: 25px;
  }
  .partner-image {
    align-content: center;
    text-align: right;
    width: 50%;
  }
  .section-title {
    font-size: var(--h1-mobile);
    padding-top: 0.25rem;
    color: var(--black);
    font-weight: var(--semibold);
  }
  .section-small-title {
    font-size: 11px;
    color: var(--red);
    font-weight: var(--semibold);
  }
  .section-start {
    display: flex;
    flex-direction: column;

    text-align: left;
    padding: 2rem;
  }
  .section-description {
    font-size: var(--p-mobile);
    padding-top: 1rem;
    color: var(--black);
  }
  .partner-navn {
    font-size: var(--p-mobile);
    padding-top: 1rem;
    text-align: left;
    font-weight: var(--semibold);
  }
  .blue-people {
    width: 60px;
    height: auto;
  }
  .flere-kommer h2 {
    font-size: var(--h2-mobile);
    color: var(--darkest-grey);
  }
  .flere-kommer {
    padding-top: 2rem;
  }
  @media (min-width: 1024px) {
    .partner-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      padding: 5rem;
    }
    .section-title {
      font-size: var(--h1);
    }
    .section-description {
      font-size: var(--p);
    }
    .section-small-title {
      font-size: var(--p);
    }
    .partner-logo {
      width: 120px;
      height: 60px;
    }
    .partner-card {
      height: 350px;
    }
    .partner-description {
      font-size: var(--p);
      max-width: 390px;
    }
    .partner-type {
      font-size: 15px;
    }
    .partner-navn {
      font-size: var(--p);
    }
    .partner-image {
      max-height: 350px;
    }
    .blue-people {
      width: 90px;
      height: auto;
    }
    .flere-kommer h2 {
      font-size: var(--p);
    }
    .flere-kommer {
      padding-top: 2.5rem;
    }
    .section-start {
      padding: 5rem;
    }
    .partner-content {
      padding-left: 2.5rem;
    }
  }
</style>
