---
import "../css/custom.css";
import "../css/reset.css";
---

<div class="hero-title">
  <h1>Vi donerer til<br />Den Danske Naturfond</h1>
  <h2>Hver gang du bruger Dankort</h2>
</div>

<style>
  h1,
  h2 {
    color: var(--white);
  }
  h1 {
    font-size: 16px;
    font-weight: var(--semibold);
  }
  h2 {
    font-size: 12px;
    font-weight: var(--regular);
  }

  /* DESKTOP */
  @media (min-width: 1024px) {
    h1 {
      font-size: var(--h1);
      font-weight: var(--semibold);
    }
    h2 {
      font-size: var(--h2);
      font-weight: var(--regular);
    }
    .hero-title {
      max-width: 33rem;
    }
  }
  @media (min-width: 1440px) {
    .hero-title {
      max-width: 35rem;
    }
  }
</style>
