---
import "../css/custom.css";
import "../css/reset.css";

const currentPath = Astro.url.pathname;
---

<div class="nav_btns">
  <a href="/" class={`nav-link ${currentPath === "/" ? "active" : ""}`}
    >Koncept</a
  >
  <a
    href="/detail"
    class={`nav-link ${currentPath === "/detail" ? "active" : ""}`}
    >Områder støttet</a
  >
  <a
    href="/stepbystep"
    class={`nav-link ${currentPath === "/stepbystep" ? "active" : ""}`}
    >Dankort i 3 trin</a
  >
</div>

<style>
  /* MOBILE FIRST */

  .nav_btns {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    position: sticky;
    top: 0;
    z-index: 999;
    justify-self: center;
  }
  .nav-link {
    background-color: var(--glass-grey);
    color: var(--white);
    border: var(--glass-border);
    font-weight: var(--title-weight);
    text-decoration: none;
    backdrop-filter: blur(5px);
    font-size: var(--button-mobile);
    transition: 0.3s ease;
    padding: var(--btn_padding-mobile);
    border-radius: 25px;
    min-width: 150px;
    max-width: 150px;
    text-align: center;
  }

  .nav-link.active {
    background: var(--glass-hover);
    color: var(--white);
  }

  @media (min-width: 375px) {
    .nav_btns {
      display: flex;
      flex-direction: row;
    }
    .nav-link {
      min-width: 110px;
      max-width: 110px;
    }
  }

  /* DESKTOP 1024PX */

  @media (min-width: 1024px) {
    .nav_btns {
      gap: 2rem;
    }

    .nav-link {
      font-size: var(--button);
      padding: var(--btn_padding);
      border-radius: 25px;
      min-width: 15rem;
      background-color: var(--glass-grey-desktop);
      color: var(--white);
      border: var(--glass-border-desktop);
    }

    .nav-link:hover {
      background: var(--glass-hover-desktop);
      cursor: pointer;
      color: var(--white);
    }
    .nav-link.active {
      background: var(--glass-hover-desktop);
      color: var(--white);
    }
    /* FUNKTION */
    .nav_btns.fixed {
      position: fixed;
      top: 20px;
      left: 50%;
      transform: translateX(-50%);
      z-index: 1000;
    }
  }
</style>

<script>
  window.addEventListener("DOMContentLoaded", () => {
    if (window.innerWidth < 1024) return;

    const nav = document.querySelector(".nav_btns");

    if (!(nav instanceof HTMLElement)) return;

    const spacer = document.createElement("div");
    spacer.style.height = `${nav.offsetHeight}px`;

    const triggerTop = nav.getBoundingClientRect().top + window.scrollY;

    window.addEventListener("scroll", () => {
      if (window.scrollY >= triggerTop) {
        if (!nav.classList.contains("fixed")) {
          nav.parentNode?.insertBefore(spacer, nav);
          nav.classList.add("fixed");
        }
      } else {
        if (nav.classList.contains("fixed")) {
          spacer.remove();
          nav.classList.remove("fixed");
        }
      }
    });
  });
</script>
