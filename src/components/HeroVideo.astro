---
import "../css/custom.css";
import "../css/reset.css";
---

<section id="hero_index">
  <video id="hero_video" autoplay loop muted playsinline preload="metadata">
    <source src="/video/hero_index.webm" type="video/webm" />
  </video>
</section>

<style>
  #hero_index {
    margin: 1rem 1rem;
    overflow: hidden;
    border-radius: 25px;
    height: 260px;
  }

  #hero_video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  @media (min-width: 1024px) {
    #hero_index {
      margin-right: 50px;
      margin-left: 50px;
      height: 80vh;
      margin-top: 48px;
    }
  }
</style>
