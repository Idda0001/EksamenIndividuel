---
import Layout from "../../layouts/Layout.astro";
import "../../css/custom.css";
import "../../css/reset.css";
import Buttons from "../../components/NavigationButtons.astro";
import { supabase } from "../../lib/supabase.js";

// Hent slug fra URL
const { slug } = Astro.params;

// Hent det specifikke naturområde fra Supabase
const { data: sted } = await supabase
  .from("naturomraader")
  .select("*")
  .eq("slug", slug)
  .single();

// Hvis området ikke findes, send til 404
if (!sted) {
  return Astro.redirect("/404");
}

// Generer alle mulige slugs til Astro's statiske routing
export async function getStaticPaths() {
  const { createClient } = await import("@supabase/supabase-js");

  const supabase = createClient(
    import.meta.env.PUBLIC_SUPABASE_URL,
    import.meta.env.PUBLIC_SUPABASE_KEY,
  );

  const { data, error } = await supabase.from("naturomraader").select("slug");

  if (error) {
    throw error;
  }

  return data.map((sted) => ({
    params: { slug: sted.slug },
  }));
}
---

<Layout>
  <main>
    <ul class="breadcrumb">
      <li><a href="/">Forside</a></li>
      <li><a href="/detail">Områder støttet</a></li>
      <li><a href="">{sted.navn}</a></li>
    </ul>
    <!-- MOBIL BILLEDE 1 -->
    <img src={sted.billede_url} alt={sted.navn} class="img_mobile-1" />
    <div class="buttons-wrapper">
      <Buttons />
    </div>

    <!-- OVERSKRIFT -->
    <h1>{sted.navn}</h1>

    <!-- DESKTOP SEKTION: collage + tekst -->
    <section class="desktop-section">
      <div class="collage-wrapper">
        <img src={sted.billede_url} alt={sted.navn} class="detail-img1" />
        <img src={sted.billede_url_2} alt={sted.navn} class="detail-img2" />
      </div>

      <div class="nature-text">
        <h2>{sted.undertitel}</h2>
        <p>{sted.beskrivelse}</p>
        <p class="kredit-p">
          (Dette tekst afsnit er skrevet ud fra: https://naturfonden.dk/ efter
          aftale med naturfonden)
        </p>
      </div>
    </section>

    <!-- MOBIL BILLEDE 2 -->
    <img src={sted.billede_url_2} alt={sted.navn} class="img_mobile-2" />

    <div class="banner_readmore">
      <div class="tekst_box_left">
        <h2>Læs mere om samarbejdet her</h2>
        <p>
          Dankort Øremærket blev lanceret i 2021 som en ordning, hvor der
          automatisk doneres 1 øre til Den Danske Naturfond, hver gang du
          betaler med dit Dankort. Initiativet blev skabt for at støtte vild,
          dansk natur og sikre store, beskyttede naturområder i Danmark.
        </p>
        <a href="https://naturfonden.dk/dankort/">Tag mig til Naturfonden</a>
      </div><img src={sted.billede_url_3} alt="" class="img-readmore" />
    </div>
  </main>
</Layout>

<style>
  .breadcrumb {
    display: flex;
    flex-direction: row;
    list-style: none;
    gap: 0.25rem;
    padding: 0.5rem;
  }
  .breadcrumb a {
    text-decoration: none;
    font-size: var(--p-mobile);
    color: var(--dark-grey);
  }
  .breadcrumb li:not(:last-child)::after {
    content: " >";
    color: var(--dark-grey);
  }
  main {
    max-width: 1200px;
    margin: 0 auto;
    align-items: center;
  }

  .nature-text,
  h1 {
    display: block;
    margin: 0 auto;
  }

  h1 {
    font-size: var(--h1-mobile);
    font-weight: var(--semibold);
    color: var(--black);
    padding: 2rem;
    padding-bottom: 0.5rem;
  }

  h2 {
    font-size: var(--h2-mobile);
    font-weight: var(--semibold);
    color: var(--darkest-grey);
    padding: 0 2rem;
  }

  p {
    font-size: var(--p-mobile);
    font-weight: var(--regular);
    color: var(--black);
    padding: 2rem;
  }
  .kredit-p {
    font-size: 10px;
    padding: 0 2rem;
  }

  .collage-wrapper {
    display: none;
  }

  .img_mobile-1,
  .img_mobile-2 {
    display: block;
    padding: 1rem;
    border-radius: 25px;
    min-width: 100%;
  }
  .banner_readmore {
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .banner_readmore h2 {
    padding-top: 2rem;
    color: var(--black);
  }
  .banner_readmore p {
    text-align: left;
  }

  .banner_readmore a {
    text-decoration: none;
    color: var(--white);
    background-color: var(--red);
    width: fit-content;
    font-size: var(--p-mobile);
    padding: 10px 15px;
    border-radius: 25px;
    margin-bottom: 1rem;

    align-self: center;
  }

  .img-readmore {
    width: 70%;
    border-radius: 25px;
    margin: 1rem 0;
  }
  .tekst_box_left {
    display: flex;
    flex-direction: column;
    align-items: left;
  }

  @media (min-width: 1024px) {
    main {
      max-width: 1200px;
    }

    h1 {
      font-size: var(--h1);
      text-align: center;
    }

    .nature-text h2 {
      display: none;
    }

    p {
      font-size: var(--p);
    }

    .desktop-section {
      display: flex;
      flex-direction: row;
      justify-content: space-between;
      margin: 0 auto;
    }

    .nature-text {
      max-width: 450px;
      padding-left: 1rem;
    }

    .img_mobile-1,
    .img_mobile-2 {
      display: none;
    }

    .collage-wrapper {
      display: block;
      position: relative;
      width: 450px;
      height: 500px;
    }

    .collage-wrapper img {
      position: absolute;
      width: 100%;
      height: auto;
      border-radius: 25px;
      object-fit: cover;
    }

    .detail-img1 {
      position: absolute;
      top: 2rem;
      left: 2rem;
      z-index: 2;
    }

    .detail-img2 {
      position: absolute;
      top: 14rem;
      left: 6rem;
      z-index: 1;
    }
    .banner_readmore {
      flex-direction: row;
    }
    .img-readmore {
      height: 20rem;
      width: 20rem;
      object-fit: cover;
      margin-right: 2rem;
      margin-top: 5rem;
    }
    .banner_readmore h2 {
      font-size: var(--h2);
      padding-top: 2rem;
      color: var(--black);
    }
    .banner_readmore p {
      font-size: var(--p);
    }

    .banner_readmore a {
      font-size: var(--p);
      padding: 15px 20px;
    }
    .kredit-p {
      font-size: 14px;
    }
    .buttons-wrapper {
      padding-top: 2rem;
    }
    .breadcrumb a {
      font-size: var(--p);
    }
    .breadcrumb {
      gap: 1rem;
    }
  }
</style>
